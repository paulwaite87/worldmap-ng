# Makefile.prod -- bespoke consumer/production Makefile for atmos-gl.
.PHONY: prod prod-down release logs psql backup restore status help bootstrap-config install-shell-alias check-git
.DEFAULT_GOAL := prod

# Variables
DB_USER = agl
DB_NAME = atmos_gl
DB_SERVICE = atmos_gl_db
DUMP_FILE = atmos_gl_dump.sql
BUILDER_SERVICE = layer_builder
BACKEND_SERVICES = data_collector layer_builder housekeeper map_api

export DOCKER_UID := $(shell id -u)
export DOCKER_GID := $(shell id -g)

check-git:
	@branch=$$(git rev-parse --abbrev-ref HEAD); \
	if [ "$$branch" != "master" ]; then \
		echo "Error: not on master (currently on '$$branch') -- checkout master before running prod."; \
		exit 1; \
	fi; \
	if [ -n "$$(git status --porcelain)" ]; then \
		echo "Error: uncommitted local changes present -- commit, stash, or discard them before running prod."; \
		exit 1; \
	fi; \
	git fetch -q origin master; \
	if [ -n "$$(git log HEAD..origin/master --oneline)" ]; then \
		echo "Error: local master is behind origin/master -- run 'git pull' before running prod."; \
		exit 1; \
	fi

bootstrap-config: install-shell-alias
	@bash scripts/bootstrap-config.sh

install-shell-alias:
	@marker="# atmos-gl: bare 'make' here runs 'make -f Makefile.prod' (added by install-shell-alias)"; \
	if [ -f ~/.bashrc ] && grep -qF "$$marker" ~/.bashrc 2>/dev/null; then \
		: ; \
	else \
		{ \
			echo ""; \
			echo "$$marker"; \
			echo "make() {"; \
			echo "  if [ \"\$$PWD\" = \"$$(pwd)\" ] && [ -f Makefile.prod ]; then"; \
			echo "    command make -f Makefile.prod \"\$$@\""; \
			echo "  else"; \
			echo "    command make \"\$$@\""; \
			echo "  fi"; \
			echo "}"; \
		} >> ~/.bashrc; \
		echo "Added a 'make' shell function to ~/.bashrc, scoped to $$(pwd) -- open a new shell (or run 'source ~/.bashrc') for bare 'make' to pick it up here. Every other directory is unaffected."; \
	fi

## prod: (default) Pull images and restart
prod: check-git bootstrap-config
	docker compose -f docker-compose.yml pull -q
	docker compose -f docker-compose.yml up -d

## prod-down: Stop the stack
prod-down:
	docker compose -f docker-compose.yml down

## release: Pull and run a specific release (version=vX.Y.Z)
release: bootstrap-config
	@if [ -z "$(version)" ]; then \
		echo "Error: version not set -- usage: make release version=vX.Y.Z"; \
		exit 1; \
	fi
	IMAGE_TAG=$(version) docker compose -f docker-compose.yml pull -q
	IMAGE_TAG=$(version) docker compose -f docker-compose.yml up -d

## logs: Tail all logs; service=name for specific service
logs:
	@COMPOSE_ARGS="-f docker-compose.yml" bash scripts/logs.sh $(service)

## psql: Open psql session in the atmos_gl database
psql:
	@COMPOSE_ARGS="-f docker-compose.yml" DB_SERVICE=$(DB_SERVICE) DB_USER=$(DB_USER) DB_NAME=$(DB_NAME) bash scripts/psql.sh

## backup: Backup database to local atmos_gl_dump.sql file
backup:
	@COMPOSE_ARGS="-f docker-compose.yml" DB_SERVICE=$(DB_SERVICE) DB_USER=$(DB_USER) DB_NAME=$(DB_NAME) DUMP_FILE=$(DUMP_FILE) bash scripts/backup.sh

## restore: Restores the local atmos_gl_dump.sql backup
restore:
	@COMPOSE_ARGS="-f docker-compose.yml" DB_SERVICE=$(DB_SERVICE) DB_USER=$(DB_USER) DB_NAME=$(DB_NAME) DUMP_FILE=$(DUMP_FILE) BACKEND_SERVICES="$(BACKEND_SERVICES)" bash scripts/restore.sh

## status: Database Status Report
status:
	@COMPOSE_ARGS="-f docker-compose.yml" BUILDER_SERVICE=$(BUILDER_SERVICE) bash scripts/status.sh

## help: Show this help menu
help:
	@echo "Available commands:"
	@sed -n 's/^##//p' $(MAKEFILE_LIST) | awk '{printf "  \033[36m%-20s\033[0m %s\n", $$1, substr($$0, index($$0,$$2))}'
