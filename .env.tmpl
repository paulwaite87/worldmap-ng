# Copy this file to your own local .env then paste your API keys below.
# For AIS API access to shipping data streams.
# Go to https://aisstream.io/documentation
AIS_API_KEY=<api_key_here>
# OpenWeather API access to lightning strikes data.
# Go to https://openweathermap.org
OPENWEATHER_API_KEY=<api_key_here>
# Map tiles API Key
MAPTILER_API_KEY=<api_key_here>
# NASA FIRMS active-fire data access.
# Go to https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_API_KEY=<api_key_here>
# CDS/ADS API access (Copernicus Atmosphere Data Store, for the greenhouse gas
# layer's anomaly baseline). Go to https://ads.atmosphere.copernicus.eu/ and
# click login/register; CDSAPI_KEY is the exact name the cdsapi library itself
# reads -- do not rename it.
CDSAPI_KEY=<api_key_here>
# NASA Earthdata Login bearer token (for the Flood Risk layer's Live mode --
# NASA LANCE MODIS observed-flood downloads). Register a free account at
# https://urs.earthdata.nasa.gov, log in, open your profile, and use "Generate
# Token" to create a Bearer token (expires after ~60 days; regenerate and update
# this value when it does -- there is no automatic renewal).
EARTHDATA_TOKEN=<api_key_here>
# Postgres credentials, shared by atmos_gl_db and every service that connects
# to it (data_collector, layer_builder, map_api, atmos_gl_db_migrate).
# Alter these BEFORE building a fresh system which creates the database.
POSTGRES_USER=agl
POSTGRES_PASSWORD=agl
POSTGRES_DB=atmos_gl
# Google sign-in (issue #303). Create OAuth 2.0 credentials at
# https://console.cloud.google.com/apis/credentials -- Authorized redirect URI must be
# <your-origin>/api/auth/callback/google (e.g. http://localhost:8180/api/auth/callback/google
# for local dev).
GOOGLE_CLIENT_ID=<client_id_here>
GOOGLE_CLIENT_SECRET=<client_secret_here>
# GitHub sign-in (issue #306). Create an OAuth App at
# https://github.com/settings/developers -- Authorization callback URL must be
# <your-origin>/api/auth/callback/github (e.g. http://localhost:8180/api/auth/callback/github
# for local dev).
GITHUB_CLIENT_ID=<client_id_here>
GITHUB_CLIENT_SECRET=<client_secret_here>
# Comma-separated allowlist of emails granted admin access (gates /config -- see #304).
ADMIN_EMAILS=<your_email_here>
# Signs the transient OAuth state cookie during the Google sign-in redirect round-trip
# only -- NOT the app's own session (that's a DB-backed opaque token, see the
# user_sessions table). Falls back to a per-process random secret if unset. Generate
# with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=<random_secret_here>
# Comma-separated origin(s) allowed to make credentialed cross-origin requests to
# map_api (CORS). Browser calls through nginx's unified origin (see #301) are
# same-origin and unaffected by this. Defaults to http://localhost:8180 if unset --
# only needed here for a non-default deployment origin.
PUBLIC_ORIGIN=http://localhost:8180

